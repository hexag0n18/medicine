# Copiar a .env, o generarlo con scripts/seed.sh (lo escribe desde los outputs de Terraform).
# Variables PUBLIC_: Astro las incluye en el codigo que descarga el navegador; no pongas secretos aqui.

# URL de Cognito.
#   floci (desarrollo): /cognito   (el servidor de Astro lo reenvia a floci, ver astro.config.mjs)
#   AWS real:           https://cognito-idp.us-east-2.amazonaws.com
PUBLIC_COGNITO_URL=/cognito

# ID del client de Cognito (output client_id de Terraform).
PUBLIC_CLIENT_ID=

# URL base de la API (sin barra final).
#   floci:    http://localhost:4566/_aws/execute-api/<api_id>/\$default   (el \ evita que Vite expanda $default)
#   AWS real: https://<api_id>.execute-api.us-east-2.amazonaws.com        (output api_url de Terraform)
PUBLIC_API_URL=
